<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Settings stay small and self-contained. Book binaries/databases are restored by the
         app's explicit Google Drive sync instead of exhausting Android Auto Backup's 25MB quota. -->
    <include domain="file" path="datastore/" />
    <include domain="file" path="fonts/" />
    <include domain="sharedpref" path="." />
    <!-- Never restore per-install sync identity, Drive cursors, or resumable upload URLs onto a
         different installation. User content is restored by the app-owned Drive protocol. -->
    <exclude domain="file" path="datastore/cloud_sync.preferences_pb" />
    <exclude domain="sharedpref" path="drive_resumable_uploads.xml" />
</full-backup-content>
